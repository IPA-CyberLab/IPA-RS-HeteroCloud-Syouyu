# Non-secret deployment settings
SYOUYU_NAMESPACE=heterocloud-syouyu
SYOUYU_RELEASE=heterocloud-syouyu
SYOUYU_IMAGE_TAG=0.1.0
SYOUYU_SECRET_NAME=heterocloud-syouyu-secrets
SYOUYU_DATABASE_PORT=5432
SYOUYU_S3_PUBLIC_ENDPOINT=https://s3.syouyu.example.com
SYOUYU_S3_ROOT_DOMAIN=.s3.syouyu.example.com
SYOUYU_GATEWAY_NAME=public-gateway
SYOUYU_GATEWAY_NAMESPACE=gateway-system
SYOUYU_GATEWAY_SECTION=https
SYOUYU_META_STORAGE_CLASS=longhorn
SYOUYU_DATA_STORAGE_CLASS=longhorn
SYOUYU_META_VOLUME_SIZE=2Gi
SYOUYU_DATA_VOLUME_SIZE=100Gi
SYOUYU_LAYOUT_CAPACITY_BYTES=95000000000
SYOUYU_LAYOUT_ZONE_A=site-a
SYOUYU_LAYOUT_ZONE_B=site-b
SYOUYU_LAYOUT_ZONE_C=site-c
SYOUYU_MAX_CREDENTIALS_PER_BUCKET=10000
SYOUYU_MAX_TOTAL_CREDENTIALS=1000000

# Secret file locations. Store only paths here, never the secret contents.
SYOUYU_DATABASE_URL_FILE=/secure/path/database-url
SYOUYU_PROVIDER_PUBLIC_KEYS_FILE=/secure/path/provider-public-keys.json
SYOUYU_RECEIPT_ENCRYPTION_KEY_FILE=/secure/path/receipt-encryption-key-base64
SYOUYU_PRINCIPAL_CONTEXT_HMAC_SECRET_FILE=/secure/path/principal-context-hmac-secret
SYOUYU_GARAGE_RPC_SECRET_FILE=/secure/path/garage-rpc-secret
SYOUYU_GARAGE_ADMIN_TOKEN_FILE=/secure/path/garage-admin-token
SYOUYU_GARAGE_METRICS_TOKEN_FILE=/secure/path/garage-metrics-token

# Example secret creation after the five files above have been provisioned:
# kubectl -n "$SYOUYU_NAMESPACE" create secret generic "$SYOUYU_SECRET_NAME" \
#   --from-file=database-url="$SYOUYU_DATABASE_URL_FILE" \
#   --from-file=provider-public-keys.json="$SYOUYU_PROVIDER_PUBLIC_KEYS_FILE" \
#   --from-file=receipt-encryption-key-base64="$SYOUYU_RECEIPT_ENCRYPTION_KEY_FILE" \
#   --from-file=principal-context-hmac-secret="$SYOUYU_PRINCIPAL_CONTEXT_HMAC_SECRET_FILE" \
#   --from-file=garage-rpc-secret="$SYOUYU_GARAGE_RPC_SECRET_FILE" \
#   --from-file=garage-admin-token="$SYOUYU_GARAGE_ADMIN_TOKEN_FILE" \
#   --from-file=garage-metrics-token="$SYOUYU_GARAGE_METRICS_TOKEN_FILE" \
#   --dry-run=client -o yaml | kubectl apply -f -
